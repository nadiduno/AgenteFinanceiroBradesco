# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#1255, shell completion scripts should be ignored too:
#  .venv
#  pipenv_shell_completion.zsh

# poetry
#   Similar to pipenv, see https://python-poetry.org/docs/configuration/#virtualenvs-in-project
#  .venv
#  poetry.lock

# pdm
